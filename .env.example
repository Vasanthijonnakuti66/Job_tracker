# Copy this file to .env and fill in your values.
# The .env file is git-ignored so secrets stay out of version control.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobtracker
DB_USERNAME=jobtracker
DB_PASSWORD=jobtracker

SERVER_PORT=8080

# At least 32 characters. Used to sign JWTs. Never commit the real value.
JWT_SECRET=local-dev-only-change-me-use-at-least-32-chars
JWT_EXPIRATION_MS=86400000

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Attachments are stored outside the database as generated files in this directory.
ATTACHMENT_STORAGE_PATH=uploads
ATTACHMENT_MAX_SIZE_BYTES=10485760
ATTACHMENT_MAX_SIZE=10MB
ATTACHMENT_MAX_REQUEST_SIZE=11MB

# Interview reminders use SMTP. Configure with your SMTP sandbox credentials.
REMINDERS_ENABLED=false
REMINDER_CRON=0 0 * * * *
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
MAIL_FROM=no-reply@jobtracker.local
